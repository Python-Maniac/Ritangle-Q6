def maponto1():
    global n
    n=2*(2**0.5)
    for i in range(53):
        points.append([points[len(points)-1][0]+n/(2**0.5), points[len(points)-1][1]])
        n/=(2**0.5)
        points.append([points[len(points)-1][0], points[len(points)-1][1]+n/(2**0.5)])
        n/=(2**0.5)

def maponto2():
    global n
    n=3
    for i in range(53):
        points2.append([points2[len(points2)-1][0]+n, points2[len(points2)-1][1]])
        n/=(3**0.5)
        points2.append([points2[len(points2)-1][0], points2[len(points2)-1][1]+n])
        n/=(3**0.5)
        points2.append([points2[len(points2)-1][0]-n, points2[len(points2)-1][1]])
        n/=(3**0.5)
        points2.append([points2[len(points2)-1][0], points2[len(points2)-1][1]-n])

